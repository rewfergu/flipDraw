{
  "name": "flipdraw",
  "version": "0.1.0",
  "description": "collaborative drawing game in javascript",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run dev",
    "dev": "bun run --parallel watch:css dev:app",
    "dev:app": "bun ./index.html",
    "build": "bun run build:css && bun build ./index.html --outdir ./build --minify",
    "build:css": "sass --no-source-map src/scss/style.scss src/css/style.css",
    "watch:css": "sass --no-source-map --watch src/scss/style.scss:src/css/style.css",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "animals": "^0.0.3",
    "firebase": "^13.4.0",
    "paper": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dragula": "^1.1.17",
    "unique-random": "^4.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "sass": "^1.108.2"
  }
}
