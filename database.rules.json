{
  "rules": {
    ".read": false,
    ".write": false,

    "$gameId": {
      // A game may be created (and only created) by a signed-in user who
      // claims a role for themselves. Authoritative fields are written by the
      // Cloud Functions using the Admin SDK, which bypasses these rules.
      ".write": "auth != null && !data.exists() && newData.hasChild(auth.uid)",

      // The secret word: readable only by the drawer.
      "currentAnimal": {
        ".read": "auth != null && data.parent().child(auth.uid).val() === 1",
        ".write": false,
        ".validate": "newData.isString() && newData.val().length <= 32"
      },

      // Everything else is not secret; any signed-in user who knows the id may
      // read it, but only participants may write.
      "letters": {
        ".read": "auth != null",
        ".write": false,
        ".validate": "newData.isString() && newData.val().length <= 16"
      },

      "completed": {
        ".read": "auth != null",
        ".write": false,
        ".validate": "newData.isBoolean()"
      },

      "winner": {
        ".read": "auth != null",
        ".write": false
      },

      "player1": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.parent().exists() || data.parent().child(auth.uid).exists())",
        ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === -1)"
      },

      "drawHeight": {
        ".read": "auth != null",
        ".write": "auth != null && data.parent().child(auth.uid).exists()",
        ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000"
      },

      "drawWidth": {
        ".read": "auth != null",
        ".write": "auth != null && data.parent().child(auth.uid).exists()",
        ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000"
      },

      "paths": {
        ".read": "auth != null",
        ".write": "auth != null && data.parent().child(auth.uid).exists()",
        "$pathId": {
          ".write": "auth != null && data.parent().parent().child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['path'])",
          "path": {
            ".validate": "newData.isString() && newData.val().length <= 20000"
          },
          // A path node carries exactly one child.
          "$extra": {
            ".validate": false
          }
        }
      },

      // The guesser proposes a guess here; checkGuess decides the outcome.
      "guesses": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && $uid === auth.uid && data.parent().parent().child(auth.uid).val() === -1",
          ".validate": "newData.isString() && newData.val().length <= 32"
        }
      },

      // A participant may ask for a new round — but only once the current one
      // has been won, so a rematch cannot be spammed mid-draw.
      "rematch": {
        ".read": "auth != null",
        ".write": "auth != null && data.parent().child(auth.uid).exists() && data.parent().child('completed').val() === true",
        ".validate": "newData.isBoolean()"
      },

      // A player may claim their own seat exactly once, and it can never be
      // changed afterwards. The creator claims their side when the game is
      // created; anyone joining later must take the OPPOSITE side. This is what
      // keeps the word secret: a guesser cannot promote themselves to drawer to
      // read `currentAnimal`, and a stranger with the link cannot claim the
      // drawer's seat.
      "$playerId": {
        ".read": "auth != null",
        ".write": "auth != null && $playerId === auth.uid && !data.exists() && (
          !data.parent().exists() ||
          newData.val() === data.parent().child('player1').val() * -1
        )",
        ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === -1)"
      }
    }
  }
}
